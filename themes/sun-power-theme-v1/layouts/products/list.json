{{- $products := .Pages -}}
{{- if eq .RelPermalink "/products/" -}}
    {{- $products = .RegularPagesRecursive -}}
{{- end -}}
[
  {{- range $index, $page := $products -}}
    {{- if $index -}},{{- end -}}
    {{- dict "id" .File.UniqueID "title" .Title "permalink" .RelPermalink "price" (.Params.price | default 0) "specs" (.Params.specs | default slice) | jsonify -}}
  {{- end -}}
]